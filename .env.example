# Midtrans Snap - isi dengan key dari https://dashboard.midtrans.com
# Sandbox: ambil dari Settings > Access Keys (Sandbox)
# Production: ganti IS_PRODUCTION=true + key production
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx

# Untuk frontend (harus pakai prefix NEXT_PUBLIC_ agar terbaca di browser)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_PRODUCTION=false

# URL situs (untuk callback finish redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
